    "rag:test": "npm --prefix workers/rag-api test",
    "rag:deploy": "npm --prefix workers/rag-api run deploy",
    "crawler:test": "python -m pytest services/crawler/tests",
    "check": "npm run type-check && npm run test && npm run rag:typecheck && npm run rag:test"
  },
