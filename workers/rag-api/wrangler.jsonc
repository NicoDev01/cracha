{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cracha-worker-rag",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DATABASE_REGISTRY",
      "id": "417ae907fb8547758b969c5eeaa635dd"
    }
  ],
  // The legacy TenantManager has already been removed. This Worker exports no
  // Durable Object classes; replaying its old deletion blocks current Wrangler.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
