{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/admin/crawl/status/[jobId]",
      "regex": "^/api/admin/crawl/status/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPjobId": "nxtPjobId"
      },
      "namedRegex": "^/api/admin/crawl/status/(?<nxtPjobId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/crawl-queue/status/[jobId]",
      "regex": "^/api/admin/crawl\\-queue/status/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPjobId": "nxtPjobId"
      },
      "namedRegex": "^/api/admin/crawl\\-queue/status/(?<nxtPjobId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/databases/[id]",
