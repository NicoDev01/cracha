# Cloudflare Workers Static Assets reads this file from the root of the asset
# directory and serves everything else with `max-age=0, must-revalidate`.
#
# That default is the expensive part. Next fingerprints every file under
# /_next/static — the name IS the content hash, so a changed file gets a new
# URL — and on a Node server Next sends `immutable` for them itself. On Workers
# it does not: the assets layer answers, and it was telling every browser to
# re-check all sixteen chunks, ~590 KB, on every single visit. A year and
# immutable is the header those filenames have always deserved.
#
# public/ is different: those names are stable across content changes, so they
# get thirty days and deliberately no `immutable` — a replaced screenshot has
# to be able to reach visitors without a rename.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
