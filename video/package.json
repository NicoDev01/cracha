{
  "name": "cracha-promo-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render CraChaPromo out/cracha-promo.mp4 --crf=16",
    "still": "remotion still CraChaPromo out/still.png",
    "typecheck": "tsc --noEmit",
    "vo:explainer": "node scripts/make-vo.mjs && node scripts/check-vo.mjs",
    "bed:explainer": "node scripts/make-bed.mjs",
    "render:explainer": "node scripts/make-sfx.mjs && remotion render CraChaExplainer out/cracha-explainer.mp4 --crf=16",
    "poster:explainer": "remotion still CraChaExplainer out/cracha-explainer-poster.png --frame=2580",
    "music:15": "node scripts/make-music.mjs",
    "render:15": "node scripts/make-music.mjs && remotion render CraCha15 out/cracha-15s.mp4 --crf=16",
    "poster:15": "remotion still CraCha15 out/cracha-15s-poster.png --frame=880"
  },
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "@remotion/google-fonts": "4.0.527",
    "lucide-react": "0.539.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
