{
  "main": ".open-next/worker.js",
  "name": "cracha",
  "compatibility_date": "2026-08-05",
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "DATABASE_REGISTRY",
      "id": "417ae907fb8547758b969c5eeaa635dd"
    }
  ],
  "services": [
    {
      "binding": "RAG_API",
      "service": "cracha-worker-rag"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GENERATION_MODEL": "google/gemini-3.5-flash-lite"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
