{
  "main": ".open-next/worker.js",
  "name": "cracha",
  "compatibility_date": "2026-08-05",
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "DATABASE_REGISTRY",
      "id": "417ae907fb8547758b969c5eeaa635dd"
    }
  ],
  "services": [
    {
      "binding": "RAG_API",
      "service": "cracha-worker-rag"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GENERATION_MODEL": "google/gemini-3.5-flash-lite",
    // The three credit packages, as one-off prices in EUR. A price id is not a
    // secret, and keeping them here means the tariff the code charges is
    // visible in the diff that changes it. The amounts they must match are in
    // src/lib/server/credits.ts: 2.500 / 7.000 / 15.000 credits for 10 / 25 /
    // 50 EUR. STRIPE_API_KEY, STRIPE_WEBHOOK_SECRET and
    // SUPABASE_SERVICE_ROLE_KEY are secrets and are set on the Worker itself.
    "STRIPE_PRICE_CREDITS_S": "",
    "STRIPE_PRICE_CREDITS_M": "",
    "STRIPE_PRICE_CREDITS_L": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
